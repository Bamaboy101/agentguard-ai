{
  "name": "AgentGuard AI - Heartbeat Monitor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "agentguard-heartbeat",
        "responseMode": "lastNode",
        "responseData": "allEntries"
      },
      "name": "Heartbeat Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 100]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "url": "http://host.docker.internal:4001/api/events",
        "jsonParameters": true,
        "bodyParametersJson": "{ \"service_id\": \"{{ $json.service_id }}\", \"run_id\": \"{{ $json.run_id }}\" }"
      },
      "name": "Forward to AgentGuard",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [460, 100]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "{{ $json.state }}",
              "operation": "equals",
              "value2": "critical"
            },
            {
              "value1": "{{ $json.state }}",
              "operation": "equals",
              "value2": "warning"
            }
          ]
        },
        "options": {
          "failOnError": false
        }
      },
      "name": "Check Service Status",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 1,
      "position": [640, 100]
    },
    {
      "parameters": {
        "to": "ops-team@example.com",
        "subject": "AgentGuard: Service Alert {{ $json.service_id }}",
        "text": "Service {{ $json.service_id }} is {{ $json.state }}. Last seen: {{ $json.last_seen_utc }}."
      },
      "name": "Send Alert",
      "type": "n8n-nodes-base.sendEmail",
      "typeVersion": 1,
      "position": [840, 100],
      "credentials": {
        "smtp": "smtp-credentials"
      }
    }
  ],
  "connections": {
    "Heartbeat Webhook": {
      "main": [
        [
          {
            "node": "Forward to AgentGuard",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forward to AgentGuard": {
      "main": [
        [
          {
            "node": "Check Service Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Service Status": {
      "main": [
        [
          {
            "node": "Send Alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
